# ==============================================================================
# AAROH Backend Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MongoDB - Authentication & Identity Database (Users, Roles, Student Credentials)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aaroh_auth_db
MONGODB_USE_MOCK_FALLBACK=true

# PostgreSQL - Educational, Learning, Assessment & Vector Data
DATABASE_URL=postgresql://aaroh_admin:aaroh_secure_pass_2026@localhost:5432/aaroh_learning_db
POSTGRES_USER=aaroh_admin
POSTGRES_PASSWORD=aaroh_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aaroh_learning_db
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=data/aaroh_backend.db

# JWT Authentication
JWT_SECRET_KEY=aaroh_jwt_super_secret_production_key_indic_2026_xyz!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Aaroh-AI Core Integration
# Optional override path to the existing Aaroh-AI folder
# AAROH_AI_PATH=C:/Users/Mayank/OneDrive/Desktop/Aaroh-AI

# AWS Bedrock / Cloud Configuration (Optional - Local mock pipeline runs when unconfigured)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=aaroh-raw-lessons-storage
S3_ENDPOINT=

# Translation Engine (IndicTrans2 / GPU SageMaker endpoint)
TRANSLATION_API_KEY=

# Speech Intelligence (AWS Polly / Indic TTS / STT)
TTS_API_KEY=
STT_API_KEY=

# Storage Directory (Local Object Storage Fallback)
LOCAL_STORAGE_DIR=data/storage

# Cache & Message Queue
REDIS_URL=
